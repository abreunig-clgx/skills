#!/usr/bin/env bash
# d2d: day-to-day data for the brief, eod and jot skills. See the d2d skills.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib.sh
. "$HERE/lib.sh"
. "$HERE/setup.sh"
. "$HERE/data.sh"
. "$HERE/brief.sh"
. "$HERE/detail.sh"

usage() {
  cat <<'EOF'
usage: d2d <command>

  setup [--name R] [--dir PATH] [--yes]   create or reuse the data repo (dry run without --yes)
  add <owner/repo>         track a repo
  remove <owner/repo>      stop tracking a repo
  status                   data repo, last EOD, tracked repos
  repos                    list tracked repos
  jot [--issue N] [--map N] [--repo o/r] "note"
  jots [date]              print a day's jots
  contributions [date]     GitHub activity for a day, flagged tracked or not
  state-write <repo> <name>   write state note from stdin
  eod-write [date]         write the day's summary from stdin
  publish                  commit and push notes
  brief                    JSON facts for the brief (read-only)
  detail <repo> [--since D] [--last-session D]   JSON facts for one repo (read-only)
  html <repo>              write reports/<repo>-<date>.html from report text on stdin
  commit-report <path>     commit one report to the data repo
EOF
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
  setup) cmd_setup "$@" ;;
  add) cmd_add "$@" ;;
  remove) cmd_remove "$@" ;;
  status) cmd_status ;;
  repos) cmd_repos ;;
  jot) cmd_jot "$@" ;;
  jots) cmd_jots "$@" ;;
  contributions) cmd_contributions "$@" ;;
  state-write) cmd_state_write "$@" ;;
  eod-write) cmd_eod_write "$@" ;;
  publish) cmd_publish ;;
  brief) cmd_brief ;;
  detail) cmd_detail "$@" ;;
  html) cmd_html "$@" ;;
  commit-report) cmd_commit_report "$@" ;;
  *) usage; [ -z "$cmd" ] || exit 1 ;;
esac
